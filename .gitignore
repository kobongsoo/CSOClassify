# ============================================================================
# CSOClassify .gitignore
#  - 비밀/자격증명, 3rd-party 라이선스 바이너리, 대용량 모델·배포산출물,
#    실행 데이터·로그는 커밋하지 않는다(소스·문서·규칙셋만 공개).
# ============================================================================

# ---- 비밀 · 자격증명 (절대 커밋 금지) --------------------------------------
.env
.env.*
.env_*
**/.env
*.pem
*.key
*.pfx

# ---- 사이냅(3rd-party 라이선스 바이너리) · 대용량 임베딩 모델 --------------
/resources/synap/
/resources/models/

# ---- 빌드 산출물 · 배포본 (생성물 · 대용량) -------------------------------
/dist/
/dist-model/
/dist-onedir/
/dist-pkg/
# Rust 포팅판 배포본 — 모델(129MB)·onnxruntime·pdfium 및 zip/tgz 묶음(각 ~90MB).
# 빌드 방법은 doc/csoclassify-빌드가이드-rust.html 에 있으므로 산출물은 커밋하지 않는다.
/Rust/dist-onedir/
/Rust/target/
# build 폴더는 스펙 파일만 남기고 PyInstaller 작업 산출물은 제외
/build/*
!/build/*.spec

# ---- 실행 데이터 · 로그 (실데이터 · 생성물) -------------------------------
/log/
*.log
/ui/*.jsonl
/ui/*.json
/ui/*.csv
**/.ipynb_checkpoints/
cso_result.jsonl
class_seed.jsonl
class_seed_audit.jsonl
cso_override.jsonl
grades.jsonl

# ---- 파이썬 캐시 · 가상환경 -----------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.venv/
venv/
env/

# ---- 스크래치 · 임시 -------------------------------------------------------
/.txt
scratch*
*.tmp
*.bak
Thumbs.db
.DS_Store

# ---- 고객사 실데이터 (공개 저장소에 올리지 않는다) -------------------------
# 분류체계 스냅샷·원본 export·그 위에 쓴 규칙은 고객사 DB(DOC_CLASSIFICATION)에서
# 나온 값이라 제품 소스가 아니다. 형식은 *.sample.yaml 로 대신 문서화한다.
# 경로를 앞에 고정하지 않는다 — Rust 포팅판이 Rust/resources/policy/ 에 같은
# 파일을 하나 더 들고 있어서, 루트만 막으면 그쪽으로 그대로 새어 나간다.
**/resources/policy/doc_taxonomy.yaml
**/resources/policy/doc_classification_export.json
**/resources/policy/doc_rule.yaml
**/resources/policy/_old-*/
# UI 가 실제로 읽고 쓰는 정책 폴더 — 실문서 경로·임베딩 벡터·승인자 이름이 들어간다.
/ui/policy/
/ui/policy_org/
/ui/settings.yaml
*.jsonl.bak*

# ---- 내부 업무 문서 --------------------------------------------------------
# 주간계획·개발일정·라벨링시트. 설계 HTML 은 기술문서라 남긴다.
/plan/*.xlsx

# ---- 편집 중 백업 · 에디터 설정 --------------------------------------------
*.bak
*.bak-*
*.bak_*
/.claude/

# ---- [2026-09-02] 저장소에 들어가면 안 되는 것 두 가지 ----------------------
# rustup 설치파일(12MB) — 3rd-party 설치 바이너리. 빌드가이드에 받는 방법이 있다.
/tools/
# `--log auto` 로 잘못 만들어진 로그 파일. 실 문서 경로가 들어 있어 공개 저장소에 두면 안 된다.
/src/auto
