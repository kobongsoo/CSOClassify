#------------------------------------------------------------------
# 리눅스 빌드서버 설정 (보기)
#=> 이 파일을 server.env 로 복사해 값을 채운다. server.env 는 .gitignore 에
#   막혀 있어 공개 저장소로 나가지 않는다.
#
#   [왜 파일로 빼나] 예전에는 서버 주소·계정·경로가 빌드 스크립트와 빌드가이드에
#   그대로 박혀 있었다. 저장소가 공개라 그 값들이 그대로 노출됐다. 값은 환경마다
#   다르고 자주 바뀌지도 않으므로, 코드에서 떼어 설정으로 두는 편이 맞다.
#
#   접속 주소·계정·비밀번호는 여기 적지 않는다 — 프로젝트 최상위의 .env_vllm
#   (SSH_SERVER · SSH_USER_ID · SSH_USER_PWD)에서 읽는다.
#------------------------------------------------------------------

# 파이썬 판을 빌드하는 폴더(서버 안 경로). PyInstaller 가 여기서 돈다.
BUILD_PY_DIR=/opt/build/python

# Rust 판을 빌드하는 폴더(서버 안 경로).
BUILD_RS_DIR=/opt/build/rust

# 임베딩 모델 원본(서버 안 경로). 배포본에 복사해 넣는다.
# spec 이 안 넣어 주는 외장 자산이라 이 경로가 틀리면 '벡터 없는 배포본'이 나간다.
MODEL_SRC_DIR=/opt/models/e5-small-ko

# conda 환경 경로. 여기서 libonnxruntime·libpdfium·libstdc++ 를 가져온다.
# CentOS 7 시스템 libstdc++(4.8.5)는 CXXABI_1.3.8+ 를 못 줘서 반드시 동봉해야 한다.
CONDA_ENV_DIR=/opt/conda/envs/build

# conda 초기화 스크립트(conda activate 를 쓰려면 필요).
CONDA_PROFILE=/opt/conda/etc/profile.d/conda.sh

# conda 환경 이름.
CONDA_ENV_NAME=build

# cargo 실행파일이 있는 폴더.
CARGO_BIN_DIR=/opt/cargo/bin
